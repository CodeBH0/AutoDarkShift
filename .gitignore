# macOS metadata
.DS_Store
._*

# SwiftPM / Xcode build output and caches
.build/
.swiftpm/
DerivedData/
build/
*.ipa
*.ipa.sha256
*.xcarchive
*.xcresult
*.dSYM

# Per-user Xcode state
*.xcuserstate
xcuserdata/
*.xccheckout
*.xcscmblueprint

# Local signing configuration and credentials (keep *.example templates)
Config/Local.xcconfig
*.p12
*.pfx
*.cer
*.key
*.mobileprovision
*.provisionprofile

# Local inputs, device exports and analysis intermediates
/local-data/
*.jsonl
*.csv
*.tsv
*.trace
*.log
# Retired local snapshots; recover source from Git history when needed
/archive/*/artifacts/
/archive/*/source/
/WORK_VPN_BRIGHTNESS.md

# Python tool caches
__pycache__/
*.py[cod]
